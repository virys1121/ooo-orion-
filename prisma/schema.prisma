generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  password      String
  role          String    @default("PARENT")
  workplace     String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  messagesSent  Message[] @relation("SentMessages")
  children      Child[]   @relation("ParentToChild")
  managedGroups Group[]   @relation("TeacherToGroup")
}

model Child {
  id        String   @id @default(cuid())
  name      String
  gender    String
  schedule  String?
  groupId   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  group     Group?   @relation(fields: [groupId], references: [id])
  parents   User[]   @relation("ParentToChild")
}

model Group {
  id            String    @id @default(cuid())
  name          String    @unique
  description   String?
  groupSchedule String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  children      Child[]
  messages      Message[]
  teachers      User[]    @relation("TeacherToGroup")
}

model Application {
  id              String             @id @default(cuid())
  parentName      String
  childName       String
  childAge        String?
  phone           String?
  parentWorkplace String
  email           String
  about           String
  childGender     String
  type            String             @default("ENROLLMENT")
  stayDates       String?
  groupId         String?
  status          String             @default("PENDING")
  fileUrl         String?
  fileName        String?
  media           ApplicationMedia[]
  createdAt       DateTime           @default(now())
}

model ApplicationMedia {
  id            String      @id @default(cuid())
  url           String
  name          String?
  applicationId String
  application   Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  createdAt     DateTime    @default(now())
}

model NewsPost {
  id        String      @id @default(cuid())
  title     String
  content   String
  authorId  String
  mediaUrl  String?
  mediaType String?
  fileName  String?
  media     NewsMedia[]
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt
}

model NewsMedia {
  id        String   @id @default(cuid())
  url       String
  type      String
  name      String?
  postId    String
  post      NewsPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
}

model Message {
  id         String         @id @default(cuid())
  content    String?
  fileUrl    String?
  fileName   String?
  senderId   String
  groupId    String?
  receiverId String?
  media      MessageMedia[]
  createdAt  DateTime       @default(now())
  group      Group?         @relation(fields: [groupId], references: [id])
  sender     User           @relation("SentMessages", fields: [senderId], references: [id])
}

model MessageMedia {
  id        String   @id @default(cuid())
  url       String
  name      String?
  messageId String
  message   Message  @relation(fields: [messageId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
}
